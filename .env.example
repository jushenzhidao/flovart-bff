# 复制为 .env 后填写。.env 已在 .gitignore 中，切勿提交。
#
#   cp .env.example .env
#
# 本地开发快速起：
#   BFF_COOKIE_SECURE=0 BFF_SECRET_KEY=$(openssl rand -hex 32) \
#     uvicorn app.main:app --host 127.0.0.1 --port 8300 --reload

# ==================== 必填 ====================

# 会话 Cookie 加密密钥。生成：openssl rand -hex 32
# 经 HKDF-SHA256 派生出 AES-256-GCM 密钥，加密会话载荷里的用户 PAT。
# /readyz 会拦空值、短于 32 字符、以及已知弱值，不通过直接 503。
BFF_SECRET_KEY=

# 上游 new-api 网关地址（Flovart 创作站所有模型都走它）。
NEWAPI_BASE_URL=http://127.0.0.1:3000

# ---- 管理员凭证：PAT 与账密都建议填 ----
# ⚠️ 多业务隔离：本仓库（flovart-bff）必须用【flovart 专属】的 new-api 管理员账号，
# 严禁与 hewapi-bff / 其他业务应用共用同一个管理员账号！new-api 的 PAT 是账号级、
# 每次 /api/user/token 都会作废旧 PAT，共用账号会让各业务的 PAT 互相踢掉（401 雪崩）；
# 且会话上限 50 硬拒绝，共用会互相挤占配额。在 new-api 用 root 后台另建独立账号。
# PAT 主通道：走 users.access_token 列，不经过 new-api 会话系统，
# 绕开「50 会话硬上限打满后 login 永久 409」单点故障。
# 获取：管理员在 new-api 前端「个人设置 → 系统访问令牌」生成。
NEWAPI_ADMIN_PAT=
NEWAPI_ADMIN_UID=

# 账密是 PAT 失效后的自愈通道（GET /api/user/token 每次都会重新生成 PAT
# 并作废旧值，官方前端点一次令牌这里配的 PAT 就失效了）。务必是上面【专属账号】的账密，
# 不要填其他业务共用的账号——否则自愈换 PAT 时仍会踢掉别人、也被别人踢。
NEWAPI_ADMIN_USERNAME=
NEWAPI_ADMIN_PASSWORD=

# 额外管理员名单（逗号分隔用户名）：上游不返回 role 或调试时兜底。
# 常规判定走上游 user.role >= 10，本项只是补充通道。
#BFF_ADMIN_USERNAMES=admin

# ==================== 可选（有生产就绪默认值）====================

# 本地开发必须设 0（Secure Cookie 在明文 http 下浏览器直接丢弃，登录会静默失败）。
# 生产默认 1，不要在生产关。
BFF_COOKIE_SECURE=1

# SameSite：默认 lax（本项目写操作全是 POST，防护足够）。
#BFF_COOKIE_SAMESITE=lax

# ==================== 积分 ====================
# new-api 内部余额单位 quota（1 元 = 500000，QuotaPerUnit 默认值，别改）
# 对外统一讲「积分」：1 元 = BFF_POINTS_PER_CNY 积分。
BFF_POINTS_PER_CNY=10000
BFF_POINTS_UNIT_NAME=积分

# 注册赠送（0 关闭）
BFF_PROMO_SIGNUP_ENABLED=1
BFF_PROMO_SIGNUP_POINTS=20000

# ==================== 品牌 ====================
BFF_BRAND_NAME=Flovart
BFF_BRAND_TAGLINE=Workflow + Table + Agent · 在线创作站
BFF_BRAND_ICP=
BFF_BRAND_CONTACT=

# ==================== 可观测性（Logfire，留空关闭）====================
# ⚠️ 请为 flovart-bff **单开一个 Logfire 项目、用它自己的 token**。
#    本项目与 hewapi-bff 部署在同一台机器上，两者一度共用同一个 token 且
#    environment 都是 local；而 hewapi 把 service_name 写死成 "newapi-bff"。
#    结果两套服务的 trace 在控制台里混成一坨，按服务过滤不出任何边界 ——
#    排查线上问题时无法判断某条报错出自哪套 BFF（2026-09-16 踩到）。
#    只改 BFF_SERVICE_NAME 而仍共用 token 是不够的：数据依然落在同一个项目的
#    额度池与留存策略里，隔离不完整。
LOGFIRE_TOKEN=
# 环境标签：生产填 flovart-prod，本地填 local。
# 带服务名前缀是刻意的 —— 万一将来又出现共用项目的情况，环境标签本身就能
# 区分归属。不给默认值：所有环境混在同一标签下，等于放弃「线上告警不被本地
# 调试流量淹没」的能力。
LOGFIRE_ENVIRONMENT=flovart-prod
# Logfire 里标识本服务的名字（控制台按 service 过滤时归到哪一堆）。
# 代码侧不写死（app/config.py 的 SERVICE_NAME 读的就是它）；这里显式写出来，
# 是为让「本服务对外叫什么」在 .env 里一眼可见，而不是去翻代码。
BFF_SERVICE_NAME=flovart-bff

# ==================== 图片任务（网关对接）====================
# ⭐ 所有图片能力统一走 `images/generations` —— 上游网关只实现这一个端点，
#   不实现 /images/edits 等语义化端点。文生图/图生图/编辑在上游本就是同一端点，
#   靠 body 里的字段区分：`image`（data URL 数组）/ `mask` / `variant` / `task`。
#   BFF 侧由 app/tasks.py:TASK_TYPES 决定每个 kind 用哪个端点 + sync/async 模式。
# ⭐⭐ 所有路径都必须带 `v1/` 前缀！
#   网关（new-api）的 OpenAI 兼容端点全部挂在 `/v1/*` 下，而 base_url 是
#   NEWAPI_BASE_URL（不带 /v1），故这里的相对路径要自带 `v1/`。
#   ⛔ 漏掉 /v1 → 打到 nginx 上不存在的路径 → 被兜底给 new-api 前端 SPA →
#      返回 200 text/html → BFF 解析失败 → 前端看到 502「网关未实现该端点」（误判）。
#   实测：POST /v1/images/generations → 401 JSON ✅ ； POST /images/generations → 200 HTML ❌
# 下方均为【可覆盖项】，默认值已收敛到 v1/images/generations，一般无需配置。
# 仅当网关后续为某能力拆出独立端点时，才用对应 env 覆盖（覆盖时也别忘 v1/）。
#GATEWAY_SYNC_IMAGE_PATH=v1/images/generations
#GATEWAY_SYNC_EDIT_PATH=v1/images/generations
#GATEWAY_SYNC_MASK_PATH=v1/images/generations
#GATEWAY_SYNC_OUTPAINT_PATH=v1/images/generations
#GATEWAY_SYNC_ANNOTATE_PATH=v1/images/generations
#GATEWAY_SYNC_RELIGHT_PATH=v1/images/generations
#GATEWAY_SYNC_UPSCALE_PATH=v1/images/generations
#GATEWAY_SYNC_REMOVE_BG_PATH=v1/images/generations
#GATEWAY_SYNC_SPLIT_PATH=v1/images/generations

# ⭐⭐ 2026-09-15 实测修正：**默认值已改为 sync，不要改回 async**。
#   本网关的图片模型**只支持 `v1/images/generations`**（同步端点，能力靠 body 里的
#   image[]/mask/variant 区分）；走 `v1/video/generations` 是**视频任务语义**，
#   图片模型必然 404 `fail_to_fetch_task`（该错误码的含义是「提交阶段上游非 200」，
#   不是「查询失败」——名字起得有误导性）。
#   改回 async 的表现：前端提交后一直 processing，最终失败。
#   async 仅保留给「确实要透传网关异步任务」的将来场景。
#GATEWAY_IMAGE_GEN_MODE=sync

# 图片异步 tasks 端点（相对 NEWAPI_BASE_URL，含 v1 前缀）
# ⭐ 2026-09-15 实测修正：new-api 的异步任务端点是 `v1/video/generations`
#   （依据源码 router/video-router.go；图片/视频共用该组，靠 body 里的模型分流）。
#   ⛔ 早期文档写的 `contents/generations/tasks` 实测 404（路径不存在），勿照抄。
#   配套轮询/取消同为 `v1/video/generations/{task_id}`（BFF 自动拼接，无需另配）。
#GATEWAY_IMAGE_TASKS_PATH=v1/video/generations
#GATEWAY_VIDEO_TASKS_PATH=v1/video/generations

# 同步调用网关的阻塞超时（秒）
#GATEWAY_SYNC_TIMEOUT=300

# ==================== 容器部署（docker compose，可选）====================
# 以下三项只有走 docker compose 时用得上；裸跑 uvicorn 请忽略。
#
# ⚠️ 本项目的 compose **刻意不用 env_file**：容器只能看到 docker-compose.yml
#    里显式列出的变量。好处是「容器里到底有什么」在 docker inspect 里一眼可见；
#    代价是新增配置项时必须同步加到 compose 的 environment 段，否则表现为
#    「宿主机 .env 配了、应用里却是默认值」。排查：docker compose exec bff env

# 镜像版本标签，compose 已设为必填 —— 落到 dev/unknown 等于放弃线上问题的回溯能力。
# 发版前用真实 git 值刷新：
#   APP_VERSION=$(git describe --tags --always)
#   VCS_REF=$(git rev-parse --short HEAD)
#APP_VERSION=v0.1.0
#VCS_REF=unknown

# 宿主端口。刻意不叫 BFF_PORT：那是 hewapi 的变量名，同机两套编排
# 若共用一个变量名，改一处会连带影响另一套。只绑回环，外网由反代进。
#FLOVART_BFF_PORT=8300

# 基础镜像。拉不到 python:3.13-slim 的内网环境可降级（代码兼容 >=3.12）。
# 国内服务器拉 Docker Hub 慢/超时的话，优先给 dockerd 配镜像加速
# （/etc/docker/daemon.json 的 registry-mirrors），比换镜像名更省事。
#PYTHON_IMAGE=python:3.13-slim

# 构建时的 pip 源。国内服务器直连 pypi.org 拉 requirements（fastapi / asyncpg /
# boto3 / Pillow / psd-tools / logfire …）极易 Read timed out，整次构建白跑。
# 这是一次性配置，写进 .env 以后每次 build 都生效：
# 注：只有「服务器本地构建」这条路线需要它。CI 构建时 runner 在境外，
#     直连官方源最快，那边刻意不设这个变量（见 .github/workflows/build-image.yml）。
#PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---- 镜像从哪来：两条路线二选一 ----
#
# A 路线 · 服务器本地构建（默认，不设 FLOVART_BFF_IMAGE）
#     docker compose build && docker compose up -d
#     镜像名 flovart-bff:<APP_VERSION>，依赖 PIP_INDEX_URL 才能快
#
# B 路线 · CI 打镜像，服务器只拉（设 FLOVART_BFF_IMAGE）
#     镜像由 .github/workflows/build-image.yml 在 push main / 打 v* tag 时
#     构建并推到 GHCR，服务器不再需要编译环境：
#       docker compose pull && docker compose up -d --no-build
#
#     ⚠️ 变量名是 FLOVART_BFF_IMAGE 而不是 BFF_IMAGE —— 刻意不与 hewapi 同名。
#        hewapi 的 .env 里也有个 BFF_IMAGE（值是它的镜像地址）。两套配置项大面积
#        相同，照抄它的 .env 时这一行会静默劫持本服务，报错长这样：
#          flovart-bff  Image ghcr.io/<owner>/newapi-bff:sha-xxxxxxx Pulling
#          ... not found
#        残留的 BFF_IMAGE 行现在会被忽略（这是设计，不是 bug）。
#
#     可用 tag（本仓库已实测推过）：latest / main / sha-<7位>
#     生产建议钉到 sha-xxxxxxx —— latest 会随每次 push main 漂移，
#     与 .env 里写的 APP_VERSION/VCS_REF 对不上时排查会很痛苦。
#
#     认证：本包实测**匿名可拉**（无需 docker login）。若日后把 GHCR 包切成
#     private，则要先认证一次：
#          echo <GitHub_PAT> | docker login ghcr.io -u <GitHub用户名> --password-stdin
#       PAT 需勾 read:packages；用户名是 GitHub 账号名（不是邮箱）。
#       凭证存在 ~/.docker/config.json，不用每次登录。
#
# ⚠️ 两条路线别混：本服务同时声明了 build 段。若 FLOVART_BFF_IMAGE 指向的镜像
#    在本地不存在、又没先 pull，compose 会回退去执行 build —— 表现为
#    「明明配了 GHCR 地址，服务器却吭哧吭哧装了十分钟依赖」。
#     正确顺序永远是：先 pull，再 up（必要时 up -d --no-build）。
#
# 上传前先验一次镜像引用真的存在（比起来了再 404 强）：
#   docker manifest inspect <下面填的完整地址> >/dev/null && echo OK
#FLOVART_BFF_IMAGE=ghcr.io/<owner>/flovart-bff:sha-xxxxxxxx

# ---- 元数据 PostgreSQL（compose 内置 postgres 服务，2026-09-20 起）----
# 只需填 POSTGRES_PASSWORD；其余四项有默认值（postgres / 5432 / flovart / flovart）。
# 密码生成：openssl rand -hex 16（十六进制纯字母数字，拼连接串不会撞特殊字符）。
# 填好后 docker compose up -d，BFF 启动自动建表+迁移，无需手工 SQL。
# 不填 POSTGRES_PASSWORD 时 compose 会直接报错拒绝启动（这是刻意的）。
#POSTGRES_PASSWORD=
#POSTGRES_HOST=postgres
#POSTGRES_PORT=5432
#POSTGRES_USER=flovart
#POSTGRES_DB=flovart

# 注意：BFF_DATA_DIR / BFF_ADMIN_CRED_FILE / BFF_SIGNUP_STATE_FILE 由
# docker-compose.yml 写死为 /data 卷，**不要在 .env 里覆盖**。
# 原因：根文件系统 read_only，这三项若沿用代码默认值（仓库根 data/，容器内即
# /app/data）会在写入时抛 OSError: [Errno 30] Read-only file system。

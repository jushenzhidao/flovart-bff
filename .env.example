# 复制为 .env 后填写。.env 已在 .gitignore 中，切勿提交。
#
#   cp .env.example .env
#
# 本地开发快速起：
#   BFF_COOKIE_SECURE=0 BFF_SECRET_KEY=$(openssl rand -hex 32) \
#     uvicorn app.main:app --host 127.0.0.1 --port 8300 --reload

# ==================== 必填 ====================

# 会话 Cookie 加密密钥。生成：openssl rand -hex 32
# 经 HKDF-SHA256 派生出 AES-256-GCM 密钥，加密会话载荷里的用户 PAT。
# /readyz 会拦空值、短于 32 字符、以及已知弱值，不通过直接 503。
BFF_SECRET_KEY=

# 上游 new-api 网关地址（Flovart 创作站所有模型都走它）。
NEWAPI_BASE_URL=http://127.0.0.1:3000

# ---- 管理员凭证：PAT 与账密都建议填 ----
# ⚠️ 多业务隔离：本仓库（flovart-bff）必须用【flovart 专属】的 new-api 管理员账号，
# 严禁与 hewapi-bff / 其他业务应用共用同一个管理员账号！new-api 的 PAT 是账号级、
# 每次 /api/user/token 都会作废旧 PAT，共用账号会让各业务的 PAT 互相踢掉（401 雪崩）；
# 且会话上限 50 硬拒绝，共用会互相挤占配额。在 new-api 用 root 后台另建独立账号。
# PAT 主通道：走 users.access_token 列，不经过 new-api 会话系统，
# 绕开「50 会话硬上限打满后 login 永久 409」单点故障。
# 获取：管理员在 new-api 前端「个人设置 → 系统访问令牌」生成。
NEWAPI_ADMIN_PAT=
NEWAPI_ADMIN_UID=

# 账密是 PAT 失效后的自愈通道（GET /api/user/token 每次都会重新生成 PAT
# 并作废旧值，官方前端点一次令牌这里配的 PAT 就失效了）。务必是上面【专属账号】的账密，
# 不要填其他业务共用的账号——否则自愈换 PAT 时仍会踢掉别人、也被别人踢。
NEWAPI_ADMIN_USERNAME=
NEWAPI_ADMIN_PASSWORD=

# 额外管理员名单（逗号分隔用户名）：上游不返回 role 或调试时兜底。
# 常规判定走上游 user.role >= 10，本项只是补充通道。
#BFF_ADMIN_USERNAMES=admin

# ==================== 可选（有生产就绪默认值）====================

# 本地开发必须设 0（Secure Cookie 在明文 http 下浏览器直接丢弃，登录会静默失败）。
# 生产默认 1，不要在生产关。
BFF_COOKIE_SECURE=1

# SameSite：默认 lax（本项目写操作全是 POST，防护足够）。
#BFF_COOKIE_SAMESITE=lax

# ==================== 积分 ====================
# new-api 内部余额单位 quota（1 元 = 500000，QuotaPerUnit 默认值，别改）
# 对外统一讲「积分」：1 元 = BFF_POINTS_PER_CNY 积分。
BFF_POINTS_PER_CNY=10000
BFF_POINTS_UNIT_NAME=积分

# 注册赠送（0 关闭）
BFF_PROMO_SIGNUP_ENABLED=1
BFF_PROMO_SIGNUP_POINTS=20000

# ==================== 品牌 ====================
BFF_BRAND_NAME=Flovart
BFF_BRAND_TAGLINE=Workflow + Table + Agent · 在线创作站
BFF_BRAND_ICP=
BFF_BRAND_CONTACT=

# ==================== 可观测性（Logfire，留空关闭）====================
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=production

# ==================== 图片任务（网关对接）====================
# ⭐ 所有图片能力统一走 `images/generations` —— 上游网关只实现这一个端点，
#   不实现 /images/edits 等语义化端点。文生图/图生图/编辑在上游本就是同一端点，
#   靠 body 里的字段区分：`image`（data URL 数组）/ `mask` / `variant` / `task`。
#   BFF 侧由 app/tasks.py:TASK_TYPES 决定每个 kind 用哪个端点 + sync/async 模式。
# ⭐⭐ 所有路径都必须带 `v1/` 前缀！
#   网关（new-api）的 OpenAI 兼容端点全部挂在 `/v1/*` 下，而 base_url 是
#   NEWAPI_BASE_URL（不带 /v1），故这里的相对路径要自带 `v1/`。
#   ⛔ 漏掉 /v1 → 打到 nginx 上不存在的路径 → 被兜底给 new-api 前端 SPA →
#      返回 200 text/html → BFF 解析失败 → 前端看到 502「网关未实现该端点」（误判）。
#   实测：POST /v1/images/generations → 401 JSON ✅ ； POST /images/generations → 200 HTML ❌
# 下方均为【可覆盖项】，默认值已收敛到 v1/images/generations，一般无需配置。
# 仅当网关后续为某能力拆出独立端点时，才用对应 env 覆盖（覆盖时也别忘 v1/）。
#GATEWAY_SYNC_IMAGE_PATH=v1/images/generations
#GATEWAY_SYNC_EDIT_PATH=v1/images/generations
#GATEWAY_SYNC_MASK_PATH=v1/images/generations
#GATEWAY_SYNC_OUTPAINT_PATH=v1/images/generations
#GATEWAY_SYNC_ANNOTATE_PATH=v1/images/generations
#GATEWAY_SYNC_RELIGHT_PATH=v1/images/generations
#GATEWAY_SYNC_UPSCALE_PATH=v1/images/generations
#GATEWAY_SYNC_REMOVE_BG_PATH=v1/images/generations
#GATEWAY_SYNC_SPLIT_PATH=v1/images/generations

# image-gen 默认走异步（透传网关异步 tasks 端点，BFF 不阻塞）；
# 若网关该模型同步更好用，置 sync 切为「BFF 阻塞直出并落盘」。
#GATEWAY_IMAGE_GEN_MODE=async

# 图片异步 tasks 端点（相对 NEWAPI_BASE_URL，含 v1 前缀）
# ⭐ 2026-09-15 实测修正：new-api 的异步任务端点是 `v1/video/generations`
#   （依据源码 router/video-router.go；图片/视频共用该组，靠 body 里的模型分流）。
#   ⛔ 早期文档写的 `contents/generations/tasks` 实测 404（路径不存在），勿照抄。
#   配套轮询/取消同为 `v1/video/generations/{task_id}`（BFF 自动拼接，无需另配）。
#GATEWAY_IMAGE_TASKS_PATH=v1/video/generations
#GATEWAY_VIDEO_TASKS_PATH=v1/video/generations

# 同步调用网关的阻塞超时（秒）
#GATEWAY_SYNC_TIMEOUT=300

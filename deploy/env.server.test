# ============================================================================
# flovart-bff 服务器 .env（直拉镜像版，配合 deploy/compose.server.yml）
#
# 由 2026-09-16 的旧版 .env 迁移（2026-09-20 按新格式重写）：
#   - 镜像 tag 不再放 .env —— 升级只改 compose.server.yml 的 image 行，
#     以下三项已删除：FLOVART_BFF_IMAGE / APP_VERSION / VCS_REF
#   - 构建期变量已删除（直拉版无 build 段，用不到）：PIP_INDEX_URL / PYTHON_IMAGE
#   - BFF_ADMIN_CRED_FILE 仍不放这里：compose.server.yml 已写死
#     /data/admin_cred.json（PAT 读回自愈会落盘到这里，重启免重复登录）
#
# ⚠️ 本文件含真实密钥，绝不提交、绝不贴聊天/issue
# ============================================================================

# ========== 必填 ==========

# 会话加密密钥 —— 与现网宝塔那份 .env 完全一致（指纹已核对过）。
# 不一致的唯一后果：所有在线用户被登出，重新登录即可，不丢账号不丢数据。
# 核对手法：grep '^BFF_SECRET_KEY=' .env | sha256sum  两边比对
BFF_SECRET_KEY=e97052e91e42d201521b435a7d4d36f1e4a4c68f02720e8fdc00d543100e8642

# new-api 网关地址（不带 /v1 —— 代码里所有网关路径自带 v1/ 前缀）
NEWAPI_BASE_URL=https://newapi-bff.oneapis.cn

# new-api 管理员账号（与 hewapi 共用同一账号时，三个值保持一致）
# ⭐ 2026-09-20 起互踢已根治（读回恢复在镜像里）：PAT 失效时 401 自愈序列 =
#    重读本机凭据文件 → login 后 GET /api/user/self 读回现行 PAT（不轮换，
#    对端服务器零感知）→ 读回为空才最后轮换兜底。不必手动维护 PAT。
NEWAPI_ADMIN_UID=1
NEWAPI_ADMIN_PAT=a1q7/yIzdwpAdZNgmMcDVb+v7+eTQo4=
NEWAPI_ADMIN_USERNAME=newapi-bff
NEWAPI_ADMIN_PASSWORD=newapi-bffnewapi-bff

# ========== 端口 / 容器 ==========

# 蓝绿切换用的临时端口。切流验证通过、停掉宝塔项目后可改回 8300
# （改完 docker compose up -d 重建，Nginx 反代目标同步调整）
FLOVART_BFF_PORT=8310
#FLOVART_BFF_CONTAINER_NAME=flovart-bff

# ========== 运行模式 / Cookie ==========
# BFF_COOKIE_SECURE / BFF_MOCK_MODE 由 compose 写死（生产 1/0），不放这里
BFF_COOKIE_SAMESITE=lax

# ========== 积分与活动（直接决定真金白银的赠送额度，改前想清楚）==========
BFF_POINTS_PER_CNY=1000
BFF_PROMO_SIGNUP_ENABLED=1
BFF_PROMO_SIGNUP_POINTS=2000
BFF_PROMO_FIRST_TOPUP_ENABLED=1
BFF_PROMO_FIRST_TOPUP_RATE=1.0

# ========== 品牌 ==========
BFF_BRAND_NAME=oneArt
# 国内公网运营按合规要求填写 ICP 备案号（留空只是页面上不显示）
#BFF_BRAND_ICP=
#BFF_BRAND_CONTACT=
# 暴露给前端的 API 地址。留空则自动取 NEWAPI_BASE_URL + /v1
BFF_API_BASE_URL=https://workbuddy.oneapis.cn/v1

# ========== 聊天默认模型（必须是网关已启用的模型名）==========
BFF_CHAT_DEFAULT_MODEL=deepseek-v4-flash
# 请求含图片时自动切换的视觉模型
BFF_CHAT_VISION_MODEL=gpt-4.1-mini

# ========== WaveSpeed（多角度等第三方直连）==========
# Key 只在容器内注入；留空则该功能整体关闭（不崩）
WAVESPEED_API_KEY=wsk_live_7LouKei_CVHgYsaNOeRSO0NgaoPUSZ7oLZmF-1OfR58
# 以下四项与 compose 默认值相同，列出仅为备查
#WAVESPEED_BASE_URL=https://api.wavespeed.ai/api
#WAVESPEED_MULTIANGLE_MODEL=wavespeed-ai/flux-kontext-dev-ultra-fast
#WAVESPEED_TIMEOUT=300
#WAVESPEED_POLL_INTERVAL=2
#WAVESPEED_POLL_MAX=120

# ========== 云数据库（留空 → 回落 /data/flovart_cloud.db SQLite）==========
#POSTGRES_DSN=
#POSTGRES_DB=flovart

# ========== 对象存储（不配 → 媒体落 /data/media 本地卷）==========
#OSS_ENABLED=0

# ========== 反代信任来源 ==========
# 反代（宝塔）在宿主机，请求经 docker 网桥进容器。必须填网桥网关，
# 不能保持 127.0.0.1（会静默丢弃 X-Forwarded-For，按 IP 限流全误伤）。
# 绝不能填 * —— 等于允许任意客户端伪造 XFF 绕过限流。
FORWARDED_ALLOW_IPS=172.17.0.1

# ========== Logfire 可观测性 ==========
# flovart 专属项目 token（v2 格式 92 字符；别沿用 hewapi 的 v1 token，数据会串项目）
LOGFIRE_TOKEN=pylf_v2_us_1cc7946c-fdd3-4f7d-9a80-33cf26f9febf_qn8kCqs2jp4RxbkZ2CKPPH9tgH52zFKBwH8xpMF4Y358
# environment 标签：同一项目内区分本地/预发/生产。本地 .env 用 pre/local，服务器用 production
LOGFIRE_ENVIRONMENT=production
# 服务名不用配：compose 写死 BFF_SERVICE_NAME=flovart-bff，与 hewapi 的 newapi-bff 天然分开

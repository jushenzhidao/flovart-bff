# flovart-bff 服务器 .env 模板（配合 deploy/compose.server.yml 直拉镜像版）。
#
# ⭐ 与旧用法的区别：镜像 tag 不在 .env 里 —— 升级时直接改 compose.server.yml
#   的 image 行，本文件里没有任何镜像相关配置。
# 迁移：把你服务器现有 .env 的同名值原样搬过来即可，然后删掉
#   FLOVART_BFF_IMAGE / APP_VERSION / VCS_REF 这几行（直拉版用不到）。

# ========== 必填 ==========
# 会话 Cookie 加密密钥：openssl rand -hex 32
# 改值会让所有在线会话立即失效，轮换安排在低峰期。
BFF_SECRET_KEY=

# new-api 网关地址
NEWAPI_BASE_URL=

# flovart 业务专属管理员账号（与 hewapi 共用同一账号时，三个值保持一致）
NEWAPI_ADMIN_UID=
# 系统访问令牌（推荐配置：不占会话配额）。失效时会走读回自愈，不必手动维护。
NEWAPI_ADMIN_PAT=
# 管理员账密（读回自愈的登录通道，必须配置）
NEWAPI_ADMIN_USERNAME=
NEWAPI_ADMIN_PASSWORD=

# ========== 端口 / 容器 ==========
# 宿主机回环端口（Nginx/Caddy 反代到这里）
FLOVART_BFF_PORT=8300
#FLOVART_BFF_CONTAINER_NAME=flovart-bff

# ========== 运行模式 / Cookie ==========
BFF_COOKIE_SAMESITE=lax

# ========== 积分与活动 ==========
BFF_POINTS_PER_CNY=1000
BFF_PROMO_SIGNUP_ENABLED=1
BFF_PROMO_SIGNUP_POINTS=2000
BFF_PROMO_FIRST_TOPUP_ENABLED=1
BFF_PROMO_FIRST_TOPUP_RATE=1.0

# ========== 品牌 ==========
BFF_BRAND_NAME=oneArt
#BFF_BRAND_ICP=
#BFF_BRAND_CONTACT=
#BFF_API_BASE_URL=

# ========== 聊天默认模型 ==========
#BFF_CHAT_DEFAULT_MODEL=
#BFF_CHAT_VISION_MODEL=

# ========== WaveSpeed（多角度等第三方）==========
WAVESPEED_API_KEY=
#WAVESPEED_BASE_URL=https://api.wavespeed.ai/api
#WAVESPEED_MULTIANGLE_MODEL=wavespeed-ai/flux-kontext-dev-ultra-fast
#WAVESPEED_TIMEOUT=300
#WAVESPEED_POLL_INTERVAL=2
#WAVESPEED_POLL_MAX=120

# ========== 云数据库（compose 内置 postgres 服务，2026-09-20 起必填）==========
# 只需填密码：openssl rand -hex 16 生成（十六进制，拼连接串不会撞特殊字符）。
# 启动时 BFF 自动建表/补列，零手工 SQL。备份 = 备 flovart-pgdata 卷。
# 其余四项有默认值（postgres / 5432 / flovart / flovart），一般不用动。
POSTGRES_PASSWORD=
#POSTGRES_HOST=postgres
#POSTGRES_PORT=5432
#POSTGRES_USER=flovart
#POSTGRES_DB=flovart
#POSTGRES_DSN=postgresql://user:pass@host:5432/flovart  # 配了会覆盖上面分项

# ========== 对象存储（不配则媒体落本地卷 /data/media）==========
#OSS_ENABLED=1
#OSS_PROVIDER=cos
#OSS_ENDPOINT=
#OSS_REGION=ap-guangzhou
#OSS_BUCKET=
#OSS_ACCESS_KEY=
#OSS_SECRET_KEY=
#OSS_PREFIX=flovart
#OSS_ADDRESSING_STYLE=auto
#OSS_PRESIGN_TTL=3600
#OSS_ENFORCE_QUOTA=1
#OSS_QUOTA_BYTES=5368709120

# ========== 反代信任（反代在宿主机时填 docker 网桥网段，不能填 *）==========
#FORWARDED_ALLOW_IPS=127.0.0.1

# ========== Logfire 可观测性（留空关闭）==========
#LOGFIRE_TOKEN=
#LOGFIRE_ENVIRONMENT=production
